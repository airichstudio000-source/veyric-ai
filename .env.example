# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_MODEL: Optional server-side Gemini chat model override.
# Allowed values: "gemini-3.1-flash-lite" or "gemini-4-hydrogen" (default / rollback model).
# Unrecognized or empty values safely fall back to "gemini-4-hydrogen".
GEMINI_MODEL="gemini-4-hydrogen"

# ---------------------------------------------------------------------------
# Public User Protection Configuration (Optional — Safe Defaults Shown)
# Invalid, negative, non-integer, or out-of-range values fall back to defaults.
# ---------------------------------------------------------------------------

# Number of trusted reverse-proxy hops when resolving client IP (1 for Cloud Run, 0-10)
TRUST_PROXY_HOPS=1

# Per-authenticated-user requests per minute on /api/chat (1-120)
RATE_LIMIT_USER_RPM=12

# Per-IP requests per minute on /api/chat across accounts (1-300)
RATE_LIMIT_IP_RPM=24

# Per-authenticated-user daily request cap on /api/chat (1-2000)
RATE_LIMIT_USER_DAILY=100

# Per-IP daily request cap on /api/chat (1-5000)
RATE_LIMIT_IP_DAILY=250

# Per-authenticated-user requests per minute on /api/followups (1-120)
RATE_LIMIT_FOLLOWUP_RPM=10

# Maximum simultaneous active chat streams per user (1-10)
MAX_CONCURRENT_PER_USER=2

# Maximum simultaneous active Gemini chat streams per server instance (1-100)
MAX_CONCURRENT_GEMINI=12

# Maximum individual attached file size in bytes (default: 26214400 = 25 MiB, max 30 MiB)
MAX_FILE_SIZE_BYTES=26214400

# Maximum number of attached files per chat message (1-10)
MAX_FILES_PER_REQUEST=5

# Maximum combined attached file size per request in bytes (default: 26214400 = 25 MiB, max 30 MiB)
MAX_TOTAL_UPLOAD_BYTES=26214400

# Maximum prompt character length per message (100-50000)
MAX_PROMPT_CHARS=8000

# Maximum number of conversation history turns forwarded per request (1-100)
MAX_HISTORY_TURNS=28

# Maximum character length for a single history turn (100-50000)
MAX_HISTORY_TURN_CHARS=8000

# Maximum total character count across all forwarded history turns (100-200000)
MAX_HISTORY_TOTAL_CHARS=48000

# Maximum multipart non-file form field size in bytes (default: 262144 = 256 KiB, max 2 MiB)
MAX_FORM_FIELD_BYTES=262144

# ---------------------------------------------------------------------------
# Private Staging Access Control (Optional — Disabled in Production)
# Allowlist activates when NODE_ENV=staging, APP_ENV=staging, or
# STAGING_ALLOWLIST_ENABLED=true. Fails closed when enabled and UID list is empty.
# ---------------------------------------------------------------------------
STAGING_ALLOWLIST_ENABLED=false
STAGING_ALLOWED_UIDS=
